(version 1)
(rule "PRIMARY_DIFFERENT_NET_3_2MM"
 (condition "(A.NetName == 'AC_L_FUSED' || A.NetName == 'FILTER_LINE_L' || A.NetName == 'AC_N' || A.NetName == 'PUMP_L_FILTERED' || A.NetName == 'PUMP_N_FILTERED' || A.NetName == 'PUMP_L_SW' || A.NetName == 'SNUBBER_RC' || A.memberOfFootprint('J1') || A.memberOfFootprint('J2') || A.memberOfFootprint('J3') || A.memberOfFootprint('J4')) && (B.NetName == 'AC_L_FUSED' || B.NetName == 'FILTER_LINE_L' || B.NetName == 'AC_N' || B.NetName == 'PUMP_L_FILTERED' || B.NetName == 'PUMP_N_FILTERED' || B.NetName == 'PUMP_L_SW' || B.NetName == 'SNUBBER_RC' || B.memberOfFootprint('J1') || B.memberOfFootprint('J2') || B.memberOfFootprint('J3') || B.memberOfFootprint('J4'))")
 (constraint clearance (min 3.2mm)))
(rule "PRIMARY_TO_SELV_8MM"
 (condition "((A.NetName == 'AC_L_FUSED' || A.NetName == 'FILTER_LINE_L' || A.NetName == 'AC_N' || A.NetName == 'PUMP_L_FILTERED' || A.NetName == 'PUMP_N_FILTERED' || A.NetName == 'PUMP_L_SW' || A.NetName == 'SNUBBER_RC' || A.memberOfFootprint('J1') || A.memberOfFootprint('J2') || A.memberOfFootprint('J3') || A.memberOfFootprint('J4')) && (B.NetName == 'V12_RAW' || B.NetName == 'V12_MOTOR' || B.NetName == 'V5_PSU' || B.NetName == 'GND_ISO' || B.NetName == 'COIL_DRAIN' || B.NetName == 'BUCK5_SW' || B.NetName == 'BUCK5_BST')) || ((B.NetName == 'AC_L_FUSED' || B.NetName == 'FILTER_LINE_L' || B.NetName == 'AC_N' || B.NetName == 'PUMP_L_FILTERED' || B.NetName == 'PUMP_N_FILTERED' || B.NetName == 'PUMP_L_SW' || B.NetName == 'SNUBBER_RC' || B.memberOfFootprint('J1') || B.memberOfFootprint('J2') || B.memberOfFootprint('J3') || B.memberOfFootprint('J4')) && (A.NetName == 'V12_RAW' || A.NetName == 'V12_MOTOR' || A.NetName == 'V5_PSU' || A.NetName == 'GND_ISO' || A.NetName == 'COIL_DRAIN' || A.NetName == 'BUCK5_SW' || A.NetName == 'BUCK5_BST'))")
 (constraint clearance (min 8mm)))
