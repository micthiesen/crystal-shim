{
  "name": "crystal-shim-pcb-designs",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "render:controller-parts": "bun run controller/design/render-parts.tsx",
    "dev:smoke": "tsci dev fixtures/tooling-smoke.circuit.tsx",
    "typecheck": "tsc --noEmit",
    "build:smoke": "tsci build fixtures/tooling-smoke.circuit.tsx --routing-disabled",
    "check:smoke": "tsci check source fixtures/tooling-smoke.circuit.tsx && tsci check pin_specification fixtures/tooling-smoke.circuit.tsx && tsci check schematic-placement fixtures/tooling-smoke.circuit.tsx && tsci check netlist fixtures/tooling-smoke.circuit.tsx && tsci check placement fixtures/tooling-smoke.circuit.tsx",
    "test": "bun run build:smoke && bun test fixtures controller/design tools/export_kicad_schematic.test.ts",
    "test:handoff": "python3 -m unittest tools.test_tscircuit_handoff",
    "lint": "oxlint --report-unused-disable-directives fixtures tools controller/design",
    "format": "oxfmt --check \"fixtures/**/*.ts\" \"fixtures/**/*.tsx\" \"tools/*.ts\" \"controller/design/**/*.ts\" \"controller/design/**/*.tsx\"",
    "check": "bun run lint && bun run format",
    "check:write": "oxlint --fix --report-unused-disable-directives fixtures tools controller/design && oxfmt --write \"fixtures/**/*.ts\" \"fixtures/**/*.tsx\" \"tools/*.ts\" \"controller/design/**/*.ts\" \"controller/design/**/*.tsx\""
  },
  "dependencies": {
    "circuit-json-to-kicad": "0.0.205",
    "polygon-clipping": "0.15.7",
    "react": "19.2.8",
    "tscircuit": "0.0.2465"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "@types/react": "19.2.18",
    "typescript": "5.9.3",
    "oxlint": "1.80.0",
    "oxfmt": "0.65.0"
  }
}
