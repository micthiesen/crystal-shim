(version 1)

(rule "Standard sensor through vias"
  (condition "A.Type == 'Via'")
  (constraint via_diameter (min 0.45mm))
  (constraint hole_size (min 0.20mm)))

(rule "No blind or microvias"
  (condition "A.Type == 'Via'")
  (constraint disallow micro_via blind_via buried_via))

(rule "Fixed inner driven shields"
  (condition "A.Layer == 'In2.Cu'")
  (constraint disallow track))

(rule "Glass face only sensor copper"
  (condition "A.Layer == 'B.Cu' && A.NetName != 'CIN_LEVEL' && A.NetName != 'CIN_RL' && A.NetName != 'SHLD1' && A.NetName != 'SHLD2'")
  (constraint disallow track))
